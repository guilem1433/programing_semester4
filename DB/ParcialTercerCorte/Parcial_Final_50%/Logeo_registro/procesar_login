$consulta->fetch();

// --- VALIDAR CONTRASEÑA ---
if ($pass !== $pass_db) {
    echo "<script>
        alert('Contraseña incorrecta.');
        window.location.href = 'index_login.html';
    </script>";
    exit;
}

// --- LOGIN EXITOSO ---
echo "<script>
    alert('Inicio de sesión exitoso');
    window.location.href = '$redirect';
</script>";

$conexion->close();

?>
