    case "cajero.com":
        $tabla = "cajero";
        $redirect = "C:/xampp/htdocs/Parcial_Final_50%/Cajero/cajero.html";
        break;

    case "cliente.com":
        $tabla = "cliente";
        $redirect = "C:/xampp/htdocs/Parcial_Final_50%/Cliente/index.html";
        break;

    case "soporte.com":
        $tabla = "soporte";
        $redirect = "C:/xampp/htdocs/Parcial_Final_50%/Soporte_Tecnico/soporte_tecnico.html";
        break;

    default:
        echo "<script>
            alert('Dominio no reconocido.');
            window.location.href = 'index_login.html';
        </script>";
        exit;
}

// --- CONSULTAR USUARIO EN LA TABLA CORRECTA ---
$consulta = $conexion->prepare("SELECT contrasena FROM $tabla WHERE correo = ?");
$consulta->bind_param("s", $correo);
$consulta->execute();
$consulta->store_result();

if ($consulta->num_rows === 0) {
    echo "<script>
        alert('Correo no registrado.');
        window.location.href = 'index_login.html';
    </script>";
    exit;
}

// OBTENER LA CONTRASEÑA GUARDADA
